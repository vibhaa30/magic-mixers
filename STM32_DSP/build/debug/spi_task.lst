  42:Core/Src/spi_task.c ****         {
  43:Core/Src/spi_task.c ****         case 1:   /* Volume: intensity maps to 0.0–1.0 */
  44:Core/Src/spi_task.c ****             g_audio_params.volume        = intensity / 255.0f;
  45:Core/Src/spi_task.c ****             g_audio_params.effects_mask |= EFFECT_VOLUME;
  46:Core/Src/spi_task.c ****             HAL_GPIO_WritePin(GPIOD, LD3_Pin, GPIO_PIN_SET);
