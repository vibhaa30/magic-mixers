  36:Core/Src/dsp_task.c **** static osThreadId       dsp_task_id;
  37:Core/Src/dsp_task.c **** 
  38:Core/Src/dsp_task.c **** /* HAL weak-symbol overrides — called from DMA ISR context.
  39:Core/Src/dsp_task.c ****    HalfCplt: first block is ready (DMA now filling second).
  40:Core/Src/dsp_task.c ****    TxRxCplt:  second block is ready (DMA wraps to first). */
  41:Core/Src/dsp_task.c **** void HAL_I2SEx_TxRxHalfCpltCallback(I2S_HandleTypeDef *hi2s)
  42:Core/Src/dsp_task.c **** {
  43:Core/Src/dsp_task.c ****     active_half = 0;
  44:Core/Src/dsp_task.c ****     osSignalSet(dsp_task_id, SIG_DMA_RDY);
  45:Core/Src/dsp_task.c **** }
  46:Core/Src/dsp_task.c **** 
  47:Core/Src/dsp_task.c **** void HAL_I2SEx_TxRxCpltCallback(I2S_HandleTypeDef *hi2s)
  48:Core/Src/dsp_task.c **** {
  49:Core/Src/dsp_task.c ****     active_half = 1;
  50:Core/Src/dsp_task.c ****     osSignalSet(dsp_task_id, SIG_DMA_RDY);
  51:Core/Src/dsp_task.c **** }
