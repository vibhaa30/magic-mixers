 119:Core/Src/dsp_task.c **** 
 120:Core/Src/dsp_task.c **** /* DSP task: highest priority.
 121:Core/Src/dsp_task.c ****    Receives audio from PCM1808 ADC (I2S RX) and sends processed audio
 122:Core/Src/dsp_task.c ****    to PCM5102A DAC (I2S TX) using full-duplex I2S3.
 123:Core/Src/dsp_task.c **** 
 124:Core/Src/dsp_task.c ****    Ping-pong: DMA (circular) continuously streams into rx_dma_buf and out
 125:Core/Src/dsp_task.c ****    of tx_dma_buf.  HalfCplt signals that the first HALF_BUF_LEN words are
 126:Core/Src/dsp_task.c ****    ready; TxRxCplt signals that the second half is ready.  The task wakes,
 127:Core/Src/dsp_task.c ****    copies the fresh RX half into the corresponding TX half, applies effects,
 128:Core/Src/dsp_task.c ****    and goes back to sleep — all before DMA wraps around to that half again. */
 129:Core/Src/dsp_task.c **** void StartDSPTask(void const *argument)
 130:Core/Src/dsp_task.c **** {
