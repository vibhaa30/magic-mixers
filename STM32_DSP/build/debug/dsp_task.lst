  15:Core/Src/dsp_task.c **** 
  16:Core/Src/dsp_task.c **** /* Ping-pong DMA buffers: two blocks back-to-back.
  17:Core/Src/dsp_task.c ****    DMA (circular) writes into one half while DSP reads the other.
  18:Core/Src/dsp_task.c ****    24-bit I2S layout per stereo pair: [L_MSW, L_LSW, R_MSW, R_LSW],
  19:Core/Src/dsp_task.c ****    so each block is AUDIO_BLOCK_SAMPLES * 4 uint16_t words. */
  20:Core/Src/dsp_task.c **** #define HALF_BUF_LEN  (AUDIO_BLOCK_SAMPLES * 4)
  21:Core/Src/dsp_task.c **** static uint16_t rx_dma_buf[HALF_BUF_LEN * 2];
  22:Core/Src/dsp_task.c **** static uint16_t tx_dma_buf[HALF_BUF_LEN * 2];
  23:Core/Src/dsp_task.c **** 
  24:Core/Src/dsp_task.c **** /* Per-channel delay ring buffers */
  25:Core/Src/dsp_task.c **** static int16_t  delay_line_L[DELAY_BUF_SAMPLES];
  26:Core/Src/dsp_task.c **** static int16_t  delay_line_R[DELAY_BUF_SAMPLES];
  27:Core/Src/dsp_task.c **** static uint16_t delay_wr = 0;
  28:Core/Src/dsp_task.c **** 
  29:Core/Src/dsp_task.c **** /* Per-channel IIR state */
  30:Core/Src/dsp_task.c **** static float lpf_L = 0.0f;
