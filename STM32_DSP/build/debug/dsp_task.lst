  92:Core/Src/dsp_task.c **** 
  93:Core/Src/dsp_task.c **** /* Sinusoidal LFO chorus (Amposta Boquera 2016).
  94:Core/Src/dsp_task.c ****    A single LFO modulates the read-head delay sinusoidally around CHORUS_BASE_DELAY.
  95:Core/Src/dsp_task.c ****    Linear interpolation gives sub-sample accuracy.  Fixed wet mix of 50%.
  96:Core/Src/dsp_task.c ****    rate: LFO frequency in Hz (0.1–3.0).
  97:Core/Src/dsp_task.c ****    24-bit layout: L_MSW at i, L_LSW at i+1, R_MSW at i+2, R_LSW at i+3; step by 4. */
  98:Core/Src/dsp_task.c **** #define CHORUS_WET  0.5f
  99:Core/Src/dsp_task.c **** 
 100:Core/Src/dsp_task.c **** static void apply_chorus(uint16_t *buf, float rate)
 101:Core/Src/dsp_task.c **** {
 102:Core/Src/dsp_task.c ****     for (int i = 0; i < HALF_BUF_LEN; i += 4) {
 103:Core/Src/dsp_task.c ****         float inL = (float)(int16_t)buf[i];
 104:Core/Src/dsp_task.c ****         float inR = (float)(int16_t)buf[i + 2];
 105:Core/Src/dsp_task.c **** 
 106:Core/Src/dsp_task.c ****         chorus_buf_L[chorus_wr] = (int16_t)inL;
 107:Core/Src/dsp_task.c ****         chorus_buf_R[chorus_wr] = (int16_t)inR;
 108:Core/Src/dsp_task.c **** 
 109:Core/Src/dsp_task.c ****         float lfo   = sinf(chorus_lfo * 6.28318f);
 110:Core/Src/dsp_task.c ****         chorus_lfo += rate / 48000.0f;
 111:Core/Src/dsp_task.c ****         if (chorus_lfo >= 1.0f) chorus_lfo -= 1.0f;
 112:Core/Src/dsp_task.c **** 
 113:Core/Src/dsp_task.c ****         float delay = (float)CHORUS_BASE_DELAY + (float)CHORUS_DEPTH * lfo;
 114:Core/Src/dsp_task.c ****         float rd_f  = (float)chorus_wr - delay;
 115:Core/Src/dsp_task.c ****         if (rd_f < 0.0f) rd_f += (float)CHORUS_BUF_SAMPLES;
 116:Core/Src/dsp_task.c **** 
 117:Core/Src/dsp_task.c ****         uint32_t i0 = (uint32_t)rd_f % CHORUS_BUF_SAMPLES;
 118:Core/Src/dsp_task.c ****         uint32_t i1 = (i0 + 1) % CHORUS_BUF_SAMPLES;
 119:Core/Src/dsp_task.c ****         float    fr = rd_f - (float)(uint32_t)rd_f;
 120:Core/Src/dsp_task.c **** 
 121:Core/Src/dsp_task.c ****         float wetL = (float)chorus_buf_L[i0] * (1.0f - fr) + (float)chorus_buf_L[i1] * fr;
 122:Core/Src/dsp_task.c ****         float wetR = (float)chorus_buf_R[i0] * (1.0f - fr) + (float)chorus_buf_R[i1] * fr;
 123:Core/Src/dsp_task.c **** 
 124:Core/Src/dsp_task.c ****         chorus_wr = (chorus_wr + 1) % CHORUS_BUF_SAMPLES;
 125:Core/Src/dsp_task.c **** 
 126:Core/Src/dsp_task.c ****         float outL = inL * (1.0f - CHORUS_WET) + wetL * CHORUS_WET;
 127:Core/Src/dsp_task.c ****         float outR = inR * (1.0f - CHORUS_WET) + wetR * CHORUS_WET;
 128:Core/Src/dsp_task.c **** 
 129:Core/Src/dsp_task.c ****         if (outL >  32767.0f) outL =  32767.0f;
 130:Core/Src/dsp_task.c ****         if (outL < -32768.0f) outL = -32768.0f;
 131:Core/Src/dsp_task.c ****         if (outR >  32767.0f) outR =  32767.0f;
 132:Core/Src/dsp_task.c ****         if (outR < -32768.0f) outR = -32768.0f;
 133:Core/Src/dsp_task.c **** 
 134:Core/Src/dsp_task.c ****         buf[i]     = (uint16_t)(int16_t)outL;
 135:Core/Src/dsp_task.c ****         buf[i + 1] = 0;
 136:Core/Src/dsp_task.c ****         buf[i + 2] = (uint16_t)(int16_t)outR;
 137:Core/Src/dsp_task.c ****         buf[i + 3] = 0;
 138:Core/Src/dsp_task.c ****     }
 139:Core/Src/dsp_task.c **** }
