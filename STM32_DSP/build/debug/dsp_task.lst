 105:Core/Src/dsp_task.c **** 
 106:Core/Src/dsp_task.c **** /* DSP task: highest priority.
 107:Core/Src/dsp_task.c ****    Receives audio from PCM1808 ADC (I2S RX) and sends processed audio
 108:Core/Src/dsp_task.c ****    to PCM5102A DAC (I2S TX) using full-duplex I2S3.
 109:Core/Src/dsp_task.c **** 
 110:Core/Src/dsp_task.c ****    Ping-pong: DMA (circular) continuously streams into rx_dma_buf and out
 111:Core/Src/dsp_task.c ****    of tx_dma_buf.  HalfCplt signals that the first HALF_BUF_LEN words are
 112:Core/Src/dsp_task.c ****    ready; TxRxCplt signals that the second half is ready.  The task wakes,
 113:Core/Src/dsp_task.c ****    copies the fresh RX half into the corresponding TX half, applies effects,
 114:Core/Src/dsp_task.c ****    and goes back to sleep — all before DMA wraps around to that half again. */
 115:Core/Src/dsp_task.c **** void StartDSPTask(void const *argument)
 116:Core/Src/dsp_task.c **** {
