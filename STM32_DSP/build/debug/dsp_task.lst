  18:Core/Src/dsp_task.c **** /* Ping-pong DMA buffers: two blocks back-to-back.
  19:Core/Src/dsp_task.c ****    DMA (circular) writes into one half while DSP reads the other.
  20:Core/Src/dsp_task.c ****    24-bit I2S layout per stereo pair: [L_MSW, L_LSW, R_MSW, R_LSW],
  21:Core/Src/dsp_task.c ****    so each block is AUDIO_BLOCK_SAMPLES * 4 uint16_t words. */
  22:Core/Src/dsp_task.c **** #define HALF_BUF_LEN  (AUDIO_BLOCK_SAMPLES * 4)
  23:Core/Src/dsp_task.c **** static uint16_t rx_dma_buf[HALF_BUF_LEN * 2];
  24:Core/Src/dsp_task.c **** static uint16_t tx_dma_buf[HALF_BUF_LEN * 2];
  25:Core/Src/dsp_task.c **** 
  26:Core/Src/dsp_task.c **** /* Chorus: circular delay lines, one per channel, plus LFO phase accumulator */
  27:Core/Src/dsp_task.c **** static int16_t  chorus_buf_L[CHORUS_BUF_SAMPLES];
  28:Core/Src/dsp_task.c **** static int16_t  chorus_buf_R[CHORUS_BUF_SAMPLES];
  29:Core/Src/dsp_task.c **** static uint32_t chorus_wr  = 0;
  30:Core/Src/dsp_task.c **** static float    chorus_lfo = 0.0f;
